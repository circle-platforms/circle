{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "epoch": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,128}$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "local",
        "hub"
      ]
    },
    "expected_state": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "check": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "confirm_purge": {
      "type": "boolean"
    }
  },
  "required": [
    "epoch",
    "operation_id",
    "mode",
    "expected_state",
    "check",
    "confirm_purge"
  ],
  "additionalProperties": false
}

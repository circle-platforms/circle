{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "check": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expected_state": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "local",
        "hub"
      ]
    },
    "personal_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "directory_grants": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "pending_shares": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "team_copies_preserved": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "check",
    "expected_state",
    "mode",
    "personal_bytes",
    "directory_grants",
    "pending_shares",
    "team_copies_preserved"
  ],
  "additionalProperties": false
}

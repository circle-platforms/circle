{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "knowledge-sync-discovery@1"
    },
    "issuer": {
      "type": "string",
      "maxLength": 2000,
      "format": "uri"
    },
    "sync": {
      "type": "object",
      "properties": {
        "versions": {
          "minItems": 1,
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "version": {
                "type": "string",
                "pattern": "^v[1-9][0-9]{0,3}$"
              },
              "base_url": {
                "type": "string",
                "maxLength": 2000,
                "format": "uri"
              },
              "capabilities": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                }
              }
            },
            "required": [
              "version",
              "base_url",
              "capabilities"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "versions"
      ],
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "properties": {
        "resource": {
          "type": "string",
          "maxLength": 2000,
          "format": "uri"
        },
        "resource_metadata": {
          "type": "string",
          "maxLength": 2000,
          "format": "uri"
        },
        "bearer_methods_supported": {
          "minItems": 1,
          "maxItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "const": "header"
          }
        }
      },
      "required": [
        "resource",
        "resource_metadata",
        "bearer_methods_supported"
      ],
      "additionalProperties": false
    },
    "local_tools": {
      "type": "object",
      "properties": {
        "base_url": {
          "type": "string",
          "maxLength": 2000,
          "format": "uri"
        }
      },
      "required": [
        "base_url"
      ],
      "additionalProperties": false
    },
    "mcp": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string",
          "maxLength": 2000,
          "format": "uri"
        },
        "capabilities": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "tool": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "argument": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "fixed": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": [
                    "string",
                    "boolean"
                  ]
                }
              }
            },
            "required": [
              "tool",
              "argument"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "endpoint",
        "capabilities"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "issuer",
    "sync",
    "authorization",
    "local_tools"
  ],
  "additionalProperties": false
}
